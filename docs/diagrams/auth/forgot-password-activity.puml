@startuml
skinparam backgroundColor White
skinparam swimlaneWidth 300
skinparam activityFontSize 13
skinparam activityBorderColor #555555
skinparam activityBackgroundColor #EBF2FF
skinparam swimlaneBorderColor #888888
skinparam arrowColor #555555

|Customer|
start
note left: Giai đoạn 1 — Yêu cầu đặt lại mật khẩu
:Nhập email\nvà nhấn Gửi yêu cầu;

|Hệ thống|
:Kiểm tra tài khoản theo email;

if (Tài khoản không tồn tại\nhoặc là tài khoản Google?) then (có)
  :Trả về thông báo thành công\n(không tiết lộ thông tin);
  note right
    Tài khoản Google không dùng mật khẩu
    → không thể đặt lại.
  end note
  |Customer|
  :Xem thông báo\n"Nếu email tồn tại, bạn sẽ nhận được hướng dẫn";
  stop
else (không)
endif

|Hệ thống|
:Sinh mã OTP 6 chữ số\nvà lưu tạm (TTL 10 phút);

|MailService|
:Gửi email chứa mã OTP\nđặt lại mật khẩu;

|Customer|
note left: Giai đoạn 2 — Đặt lại mật khẩu
:Kiểm tra email\n+ nhập mã OTP và mật khẩu mới;

|Hệ thống|
:Xác thực mã OTP;

if (OTP không hợp lệ\nhoặc đã hết hạn?) then (có)
  #FFDDDD:Trả về thông báo lỗi chung;

  |Customer|
  #FFDDDD:Xem thông báo lỗi;
  stop
else (không)
endif

|Hệ thống|
:Cập nhật mật khẩu mới\n(hash bcrypt) + xóa OTP;

|Customer|
:Mật khẩu được cập nhật\n+ chuyển về trang đăng nhập;
stop

@enduml
