sequenceDiagram
    autonumber
    actor Admin
    participant FE as Frontend<br/>(Next.js)
    participant BE as Backend<br/>(UsersController + UsersService)
    participant Users as MongoDB (users)
    participant Mail as MailService

    Admin->>FE: Yêu cầu đặt lại mật khẩu cho nhân viên
    FE->>BE: POST /users/staff/:id/reset-password

    BE->>Users: Tìm staff theo id (deletedAt: null)

    alt Không tìm thấy
        Users-->>BE: null
        BE-->>FE: 404 Không tìm thấy nhân viên
        FE-->>Admin: Hiển thị lỗi
    else Tài khoản đăng nhập qua OAuth (không có mật khẩu local)
        Users-->>BE: user với provider != local
        BE-->>FE: 400 Không thể đặt lại mật khẩu tài khoản OAuth
        FE-->>Admin: Hiển thị lỗi
    else Hợp lệ
        Users-->>BE: user document (provider: local)
        BE->>BE: Tạo mật khẩu ngẫu nhiên 10 ký tự
        BE->>BE: bcrypt.hash(newPassword)
        Note over BE: Mã hoá mật khẩu mới trước khi lưu
        BE->>Users: $set { password: hashedPassword }
        BE-)Mail: Gửi email thông báo mật khẩu mới
        BE-->>FE: 200 { success: true }
        FE-->>Admin: Thông báo đặt lại mật khẩu thành công
    end
